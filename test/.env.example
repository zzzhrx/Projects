# Gemini API 配置（必填）
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE=https://api.ikuncode.cc
AGENT_MODEL=gemini-3.1-pro-preview
AGENT_TEMPERATURE=0
AGENT_TIMEZONE=Asia/Shanghai

# 高德地图 API（可选，不填则不注册地图工具）
AMAP_API_KEY=your-amap-api-key

# Tavily 搜索 API（可选，不填则不注册搜索工具）
TAVILY_API_KEY=your-tavily-api-key
